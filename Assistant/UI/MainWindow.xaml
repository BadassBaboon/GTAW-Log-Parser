<Controls:MetroWindow x:Name="Main" x:Class="Assistant.UI.MainWindow"
                      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:local="clr-namespace:Assistant.UI"
                      mc:Ignorable="d"
                      ResizeMode="CanMinimize"
                      WindowStartupLocation="CenterScreen"
                      Closing="Main_Closing"
                      GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                      Title="GTA World Chat Log Assistant" Height="344" Width="640" IsMaxRestoreButtonEnabled="False" IsMinButtonEnabled="True" TitleCharacterCasing="Normal" ShowIconOnTitleBar="False" Icon="pack://application:,,,/GTAWAssistant;component/Resources/AppIcon.ico">

    <Controls:MetroWindow.RightWindowCommands>
        <Controls:WindowCommands>
            <Button x:Name="CreateDesktopShortcut"
                    Click="CreateDesktopShortcut_Click"
                    Content="{iconPacks:Material OpenInApp, Width=18, Height=18}"
                    ToolTip="Create GTA World Desktop Shortcut" />

            <Button x:Name="OpenDiscord"
                    Click="OpenDiscord_Click"
                    ToolTip="Join Baboon's Workshop">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              Data="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
                    </Canvas>
                </Viewbox>
            </Button>

            <Button x:Name="OpenProgramSettings"
                    Click="OpenProgramSettings_Click"
                    Content="{iconPacks:Material Cog, Width=18, Height=18}"
                    ToolTip="Settings" />

            <Button x:Name="OpenGithubProject"
                    Visibility="Collapsed"
                    Click="OpenGithubProject_Click"
                    Content="{iconPacks:Material Github, Width=20, Height=20}"
                    ToolTip="Open the project page on GitHub" />

            <Button x:Name="OpenGithubReleases"
                    Visibility="Collapsed"
                    Click="OpenGithubReleases_Click"
                    Content="{iconPacks:Material Download, Width=16, Height=16}"
                    ToolTip="Open the releases page on GitHub" />

            <Button x:Name="OpenUCP"
                    Visibility="Collapsed"
                    Click="OpenUCP_Click"
                    Content="{iconPacks:Material CardBulletedOutline, Width=20, Height=20}"
                    ToolTip="Open the GTA World UCP" />

            <Button x:Name="OpenFacebrowser"
                    Visibility="Collapsed"
                    Click="OpenFacebrowser_Click"
                    Content="{iconPacks:Material Facebook, Width=16, Height=16}"
                    ToolTip="Open Facebrowser" />

            <Button x:Name="OpenForums"
                    Visibility="Collapsed"
                    Click="OpenForums_Click"
                    Content="{iconPacks:Material Web, Width=18, Height=18}"
                    ToolTip="Open the GTA World forums" />
        </Controls:WindowCommands>
    </Controls:MetroWindow.RightWindowCommands>

    <DockPanel>
        <Menu x:Name="MenuStrip" DockPanel.Dock="Top" Height="32" Padding="0" Margin="0">
            <MenuItem x:Name="BackupSettingsToolStripMenuItem" Header="Automatic Backup Settings" Click="BackupSettingsToolStripMenuItem_Click"/>
            <MenuItem x:Name="FilterChatLogToolStripMenuItem" Header="Filter Chat Log" Click="FilterChatLogToolStripMenuItem_Click"/>
            <MenuItem x:Name="LiveTailToolStripMenuItem" Header="Live Tail" Click="LiveTailToolStripMenuItem_Click"/>
            <MenuItem x:Name="FiveMToolsToolStripMenuItem" Header="FiveM Tools" Click="FiveMToolsToolStripMenuItem_Click"/>
            <MenuItem x:Name="LanguageToolStripMenuItem" Header="Change Server" Visibility="Collapsed"/>
            <MenuItem x:Name="AboutToolStripMenuItem" Header="About" Click="AboutToolStripMenuItem_Click"/>
            <MenuItem x:Name="ExitToolStripMenuItem" Header="Exit" Visibility="Hidden" Click="ExitToolStripMenuItem_Click"/>
        </Menu>

        <Grid>
            <!-- Log Parser Tab Content -->
            <Grid x:Name="LogParserGrid" Visibility="Visible">
                <Image x:Name="Logo" HorizontalAlignment="Left" Height="140" VerticalAlignment="Top" Width="288" Source="../Resources/Logo.png" Margin="10,0,0,0" Stretch="Fill"/>
                <CheckBox x:Name="RemoveTimestamps" Checked="RemoveTimestamps_CheckedChanged" Unchecked="RemoveTimestamps_CheckedChanged" Content="Remove timestamps" ToolTip="Strip timestamp prefixes from chat messages" HorizontalAlignment="Left" Margin="10,148,0,0" VerticalAlignment="Top" Width="288"/>
                <CheckBox x:Name="BindTilde" Checked="BindTilde_CheckedChanged" Unchecked="BindTilde_CheckedChanged" Content="Bind ~ to T (Like SA:MP)" ToolTip="Binds the tilde key (~) to open in-game chat" HorizontalAlignment="Left" Margin="10,174,0,0" VerticalAlignment="Top" Width="288"/>
                <CheckBox x:Name="LivePreview" Checked="LivePreview_CheckedChanged" Unchecked="LivePreview_CheckedChanged" Content="Live preview" ToolTip="Continuously update the text box in real-time as chat messages arrive" HorizontalAlignment="Left" Margin="10,200,0,0" VerticalAlignment="Top" Width="288"/>
                <Controls:ProgressRing x:Name="UpdateCheckProgress"
                                       Width="16"
                                       Height="16"
                                       Foreground="Black"
                                       IsActive="False"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Visibility="Collapsed" Margin="530,6,0,0"/>

                <Label x:Name="CaptureStatus" Content="Chat capture: Waiting for FiveM" HorizontalContentAlignment="Left" HorizontalAlignment="Left" Margin="298,0,0,0" VerticalAlignment="Top" Width="250"/>
                <TextBlock x:Name="Version" TextWrapping="NoWrap" Text="v1.0.0" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Margin="549,5,0,0" Height="26"/>
                <TextBox x:Name="Parsed" TextChanged="Parsed_TextChanged" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible" HorizontalAlignment="Left" Height="176" Margin="303,28,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="321" AcceptsReturn="True"/>
                <Label x:Name="StatusLabel" Content="Automatic Backup: OFF" HorizontalContentAlignment="Left" HorizontalAlignment="Left" Margin="298,208,0,0" VerticalAlignment="Top" Width="160"/>
                <TextBlock TextWrapping="NoWrap" x:Name="Counter" Text="0 characters and 0 lines" TextAlignment="Right" HorizontalAlignment="Left" Margin="463,213,0,0" VerticalAlignment="Top" Width="161" Height="26"/>
                
                <Button x:Name="Parse" Click="Parse_Click" Content="Parse" ToolTip="Parse the current FiveM chat session" HorizontalAlignment="Left" Margin="303,238,0,0" VerticalAlignment="Top" Width="75"/>
                <Button x:Name="SaveParsed" Click="SaveParsed_Click" Content="Save As" ToolTip="Save parsed chat log to a text file" HorizontalAlignment="Left" Margin="383,238,0,0" VerticalAlignment="Top" Width="75"/>
                <Button x:Name="CopyParsedToClipboard" Click="CopyParsedToClipboard_Click" Content="Copy To Clipboard" ToolTip="Copy parsed chat log to clipboard" HorizontalAlignment="Left" Margin="463,238,0,0" VerticalAlignment="Top" Width="161"/>
            </Grid>
            
            <!-- AI Assistant Tab Content -->
            <Grid x:Name="AiAssistantGrid" Visibility="Collapsed">
                <!-- Left Column: Settings -->
                <Label Content="Configure AI Feature:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="160"/>
                <ComboBox x:Name="AiMode" SelectionChanged="AiMode_SelectionChanged" HorizontalAlignment="Left" Margin="10,33,0,0" VerticalAlignment="Top" Width="260">
                    <ComboBoxItem Content="Change Accent"/>
                    <ComboBoxItem Content="Translate Language"/>
                    <ComboBoxItem Content="Auto-Correct"/>
                </ComboBox>

                <Label x:Name="AiTargetLabel" Content="Target Accent (e.g. Texan Accent, Donald Trump):" HorizontalAlignment="Left" Margin="10,65,0,0" VerticalAlignment="Top" Width="280"/>
                <TextBox x:Name="AiTargetInput" TextChanged="AiTargetInput_TextChanged" HorizontalAlignment="Left" Margin="10,88,0,0" VerticalAlignment="Top" Width="260" Height="25" VerticalContentAlignment="Center"/>

                <Label Content="Output Length Constraint:" HorizontalAlignment="Left" Margin="10,120,0,0" VerticalAlignment="Top" Width="180"/>
                <ComboBox x:Name="AiLength" SelectionChanged="AiLength_SelectionChanged" HorizontalAlignment="Left" Margin="10,143,0,0" VerticalAlignment="Top" Width="260">
                    <ComboBoxItem Content="No Constraint"/>
                    <ComboBoxItem Content="Similar Length"/>
                    <ComboBoxItem Content="Concise"/>
                </ComboBox>

                <Label Content="AI Model:" HorizontalAlignment="Left" Margin="10,175,0,0" VerticalAlignment="Top" Width="150"/>
                <ComboBox x:Name="AiModel" IsEditable="True" SelectionChanged="AiModel_SelectionChanged" TextBoxBase.TextChanged="AiModel_TextChanged" HorizontalAlignment="Left" Margin="10,198,0,0" VerticalAlignment="Top" Width="235">
                    <ComboBoxItem Content="openai/gpt-oss-20b"/>
                    <ComboBoxItem Content="openai/gpt-oss-120b"/>
                    <ComboBoxItem Content="groq/compound"/>
                    <ComboBoxItem Content="groq/compound-mini"/>
                </ComboBox>
                <Button x:Name="ModelInfoHelpBtn" Click="ModelInfoHelpBtn_Click" Content="?" HorizontalAlignment="Left" Margin="248,198,0,0" VerticalAlignment="Top" Width="22" Height="25" FontWeight="Bold"/>

                <!-- Right Column: Hook & Keys -->
                <Label Content="Settings:" HorizontalAlignment="Left" Margin="300,10,0,0" VerticalAlignment="Top" Width="150"/>
                <CheckBox x:Name="AiSoundEnabled" Checked="AiSoundEnabled_CheckedChanged" Unchecked="AiSoundEnabled_CheckedChanged" Content="Notification sound" HorizontalAlignment="Left" Margin="300,33,0,0" VerticalAlignment="Top" Width="140"/>
                <CheckBox x:Name="AiFiveMOnlyEnabled" Checked="AiFiveMOnlyEnabled_CheckedChanged" Unchecked="AiFiveMOnlyEnabled_CheckedChanged" Content="FiveM hotkey only" ToolTip="Only intercept hotkeys when FiveM is the active foreground window" HorizontalAlignment="Left" Margin="448,33,0,0" VerticalAlignment="Top" Width="155"/>
                <CheckBox x:Name="AiPhoneticEnabled" Checked="AiPhoneticEnabled_CheckedChanged" Unchecked="AiPhoneticEnabled_CheckedChanged" Content="Phonetic Spelling" HorizontalAlignment="Left" Margin="300,55,0,0" VerticalAlignment="Top" Width="140"/>
                <CheckBox x:Name="AiActionEnricherEnabled" Checked="AiActionEnricherEnabled_CheckedChanged" Unchecked="AiActionEnricherEnabled_CheckedChanged" Content="Action Enricher" HorizontalAlignment="Left" Margin="448,55,0,0" VerticalAlignment="Top" Width="155"/>

                <Label Content="Active AI Features &amp; Shortcuts:" HorizontalAlignment="Left" Margin="300,85,0,0" VerticalAlignment="Top" Width="220"/>
                <Button x:Name="RecordAccentHotkeyBtn" Click="RecordAccentHotkeyBtn_Click" Content="Accent &amp; Enricher: Ctrl+T" HorizontalAlignment="Left" Margin="300,108,0,0" VerticalAlignment="Top" Width="238" Height="25"/>
                <CheckBox x:Name="AiAccentEnabled" Checked="AiAccentEnabled_CheckedChanged" Unchecked="AiAccentEnabled_CheckedChanged" Content="On" ToolTip="Enable Accent Feature &amp; Hotkey" HorizontalAlignment="Left" Margin="548,112,0,0" VerticalAlignment="Top" Width="55"/>

                <Button x:Name="RecordTranslateHotkeyBtn" Click="RecordTranslateHotkeyBtn_Click" Content="Translate: Ctrl+U" HorizontalAlignment="Left" Margin="300,138,0,0" VerticalAlignment="Top" Width="238" Height="25"/>
                <CheckBox x:Name="AiTranslateEnabled" Checked="AiTranslateEnabled_CheckedChanged" Unchecked="AiTranslateEnabled_CheckedChanged" Content="On" ToolTip="Enable Translate Feature &amp; Hotkey" HorizontalAlignment="Left" Margin="548,142,0,0" VerticalAlignment="Top" Width="55"/>

                <Button x:Name="RecordCorrectHotkeyBtn" Click="RecordCorrectHotkeyBtn_Click" Content="Auto-Correct: Ctrl+H" HorizontalAlignment="Left" Margin="300,168,0,0" VerticalAlignment="Top" Width="238" Height="25"/>
                <CheckBox x:Name="AiCorrectEnabled" Checked="AiCorrectEnabled_CheckedChanged" Unchecked="AiCorrectEnabled_CheckedChanged" Content="On" ToolTip="Enable Auto-Correct Feature &amp; Hotkey" HorizontalAlignment="Left" Margin="548,172,0,0" VerticalAlignment="Top" Width="55"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="300,200,0,0" VerticalAlignment="Top">
                    <Label Content="Temperature:" Width="82" Padding="0,0,0,0" VerticalContentAlignment="Center"/>
                    <Slider x:Name="AiTemperature" ValueChanged="AiTemperature_ValueChanged" Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True" Width="140" VerticalAlignment="Center"/>
                    <Label x:Name="AiTemperatureLabel" Content="0.6" Width="30" Padding="4,0,0,0" VerticalContentAlignment="Center"/>
                </StackPanel>

                <Button x:Name="ManageKeysBtn" Click="ManageKeysBtn_Click" Content="Manage API Keys" HorizontalAlignment="Left" Margin="300,238,0,0" VerticalAlignment="Top" Width="148" Height="26"/>
                <Button x:Name="ManageProfilesBtn" Click="ManageProfilesBtn_Click" Content="Accent Profiles" HorizontalAlignment="Left" Margin="457,238,0,0" VerticalAlignment="Top" Width="148" Height="26"/>
            </Grid>

            <!-- Bottom Left Tab Navigation Buttons (Shared across both grids) -->
            <Button x:Name="TabLogParserBtn" Content="LOG PARSER" Click="TabLogParserBtn_Click" HorizontalAlignment="Left" Margin="10,238,0,0" VerticalAlignment="Top" Width="135" Height="26"/>
            <Button x:Name="TabAiAssistantBtn" Content="AI ASSISTANT" Click="TabAiAssistantBtn_Click" HorizontalAlignment="Left" Margin="150,238,0,0" VerticalAlignment="Top" Width="135" Height="26"/>
        </Grid>
    </DockPanel>
</Controls:MetroWindow>
