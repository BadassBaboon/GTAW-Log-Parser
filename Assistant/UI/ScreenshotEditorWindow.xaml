<Controls:MetroWindow x:Class="Assistant.UI.ScreenshotEditorWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                      mc:Ignorable="d"
                      Title="Screenshot Editor"
                      TitleCharacterCasing="Normal"
                      Height="880" Width="1400"
                      MinWidth="1100" MinHeight="720"
                      WindowStartupLocation="CenterOwner"
                      GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                      ShowIconOnTitleBar="False"
                      Icon="pack://application:,,,/GTAWAssistant;component/Resources/AppIcon.ico"
                      KeyDown="MetroWindow_KeyDown">

    <Window.Resources>

        <!-- A numbered step header, so the left-to-right workflow is legible without tab hunting. -->
        <Style x:Key="StepHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SecondaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToolbarSegment" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Separator}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- Standard transparency checkerboard. Two 8px squares in a 16px tile; the tones are
             swapped at runtime for light mode so the pattern stays legible either way. -->
        <DrawingBrush x:Key="CheckerboardBrush" TileMode="Tile"
                      Viewport="0,0,16,16" ViewportUnits="Absolute"
                      Stretch="None" RenderOptions.CachingHint="Cache">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource ScreenshotCheckerLight}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{DynamicResource ScreenshotCheckerDark}">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8"/>
                                <RectangleGeometry Rect="8,8,8,8"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="PaneBody" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Separator}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>

    </Window.Resources>

    <Grid Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ============ TOP COMMAND BAR ============ -->
        <Border Grid.Row="0" Background="{DynamicResource MahApps.Brushes.Gray10}"
                BorderBrush="{DynamicResource MahApps.Brushes.Separator}" BorderThickness="0,0,0,1" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource ToolbarSegment}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="OpenImageBtn" Click="OpenImageBtn_Click" Height="27" Padding="9,0" Margin="0,0,2,0" ToolTip="Open an image (Ctrl+O)">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FolderImage" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Open" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PasteImageBtn" Click="PasteImageBtn_Click" Height="27" Padding="9,0" ToolTip="Paste an image from the clipboard (Ctrl+V)">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ClipboardOutline" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Paste" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ToolbarSegment}" Padding="7,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="AspectRatio" Width="13" Height="13" Margin="0,0,7,0"
                                                        Foreground="{DynamicResource MahApps.Brushes.Gray3}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ResolutionPresetCombo" SelectionChanged="ResolutionPresetCombo_SelectionChanged"
                                      Width="200" Height="25" FontSize="12" Margin="0,0,8,0"/>
                            <TextBox x:Name="CanvasWidthTextBox" Text="1300" Width="46" Height="25" TextAlignment="Center"
                                     VerticalContentAlignment="Center" TextChanged="CanvasDimensions_TextChanged" ToolTip="Canvas width in pixels"/>
                            <TextBlock Text="×" Margin="5,0" VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                            <TextBox x:Name="CanvasHeightTextBox" Text="730" Width="46" Height="25" TextAlignment="Center"
                                     VerticalContentAlignment="Center" TextChanged="CanvasDimensions_TextChanged" ToolTip="Canvas height in pixels"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ToolbarSegment}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AspectFitBtn" Click="AspectFitBtn_Click" Content="Fit" Height="25" Padding="9,0" Margin="0,0,2,0" FontSize="11.5" ToolTip="Scale the image to fit inside the canvas"/>
                            <Button x:Name="AspectFillBtn" Click="AspectFillBtn_Click" Content="Fill" Height="25" Padding="9,0" Margin="0,0,2,0" FontSize="11.5" ToolTip="Scale the image to cover the canvas"/>
                            <Button x:Name="ResetViewBtn" Click="ResetViewBtn_Click" Content="Reset" Height="25" Padding="9,0" FontSize="11.5" ToolTip="Reset pan and zoom to 100%"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ToolbarSegment}" Padding="7,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="Magnify" Width="13" Height="13" Margin="0,0,6,0"
                                                        Foreground="{DynamicResource MahApps.Brushes.Gray3}" VerticalAlignment="Center"/>
                            <Slider x:Name="ZoomSlider" Minimum="10" Maximum="400" Value="100" Width="85" Height="20"
                                    VerticalAlignment="Center" Margin="0,0,6,0"
                                    ValueChanged="ZoomSlider_ValueChanged"
                                    ToolTip="Zoom image manually (10% to 400%)"/>
                            <TextBlock x:Name="ZoomValText" Text="100%" Width="36" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MahApps.Brushes.Gray3}" TextAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CopyToClipboardBtn" Click="CopyToClipboardBtn_Click"
                            Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                            Height="31" Padding="13,0" Margin="0,0,8,0" ToolTip="Copy the rendered image to the clipboard (Ctrl+Shift+C)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentCopy" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Copy Image" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SavePngBtn" Click="SavePngBtn_Click" Height="31" Padding="10,0" Margin="0,0,4,0" ToolTip="Save as PNG">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Download" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="PNG" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SaveJpegBtn" Click="SaveJpegBtn_Click" Height="31" Padding="10,0" ToolTip="Save as JPEG">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileImageOutline" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="JPEG" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ WORKSPACE ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="430" MinWidth="380" MaxWidth="620"/>
            </Grid.ColumnDefinitions>

            <!-- CANVAS VIEWPORT -->
            <Grid x:Name="ViewportSurface" Grid.Column="0" ClipToBounds="True"
                  MouseDown="Viewport_MouseDown" MouseMove="Viewport_MouseMove"
                  MouseUp="Viewport_MouseUp" MouseWheel="Viewport_MouseWheel">

                <Grid x:Name="ViewportGrid" HorizontalAlignment="Center" VerticalAlignment="Center"
                      SizeChanged="ViewportGrid_SizeChanged">
                    <Border x:Name="CanvasFrame" CornerRadius="3" Margin="-6">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Opacity="0.7"/>
                        </Border.Effect>
                    </Border>

                    <!-- Sits behind the rendered bitmap and is exactly its size, so any canvas the
                         image no longer covers reads as transparent rather than as black padding. -->
                    <Rectangle x:Name="CheckerboardLayer" Fill="{StaticResource CheckerboardBrush}"
                               Width="{Binding ActualWidth, ElementName=CanvasPreviewImage}"
                               Height="{Binding ActualHeight, ElementName=CanvasPreviewImage}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <Image x:Name="CanvasPreviewImage" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Selection adorner. Drawn as live WPF chrome rather than baked into the
                         bitmap, so what you export never contains the editing outline. -->
                    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" ClipToBounds="True">
                        <Rectangle x:Name="ChatBlockOutline" Visibility="Collapsed"
                                   Stroke="{DynamicResource MahApps.Brushes.Accent}" StrokeThickness="1"
                                   Fill="{DynamicResource ScreenshotSelectionFill}" RadiusX="2" RadiusY="2">
                            <Rectangle.StrokeDashArray>
                                <DoubleCollection>3 2</DoubleCollection>
                            </Rectangle.StrokeDashArray>
                        </Rectangle>
                    </Canvas>
                </Grid>

                <!-- Empty state: says what to do, instead of showing a blank black rectangle. -->
                <Border x:Name="EmptyStateHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource ScreenshotOverlayFill}" BorderBrush="{DynamicResource ScreenshotOverlayBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="26,20" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="ImagePlus" Width="26" Height="26" HorizontalAlignment="Center"
                                                    Foreground="{DynamicResource ScreenshotOverlayMuted}" Margin="0,0,0,10"/>
                        <TextBlock Text="Drop in a screenshot to begin" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ScreenshotOverlayText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Open, or paste with Ctrl+V" FontSize="11.5"
                                   Foreground="{DynamicResource ScreenshotOverlayMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                        Background="{DynamicResource ScreenshotOverlayFill}" BorderBrush="{DynamicResource ScreenshotOverlayBorder}" BorderThickness="1"
                        CornerRadius="5" Padding="8,5" IsHitTestVisible="False">
                    <TextBlock x:Name="ViewportHintText" FontSize="11" Foreground="{DynamicResource ScreenshotOverlayText}"
                               Text="Drag the chat block to move it · Right-drag to pan · Wheel to zoom"/>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource MahApps.Brushes.Separator}" Cursor="SizeWE"/>

            <!-- INSPECTOR -->
            <Grid Grid.Column="2" Margin="8,8,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*" MinHeight="170"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- STEP 1 : PICK LINES -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,7">
                        <Border Style="{StaticResource StepNumber}">
                            <TextBlock Text="1" Foreground="White" FontSize="10.5" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Pick lines" Style="{StaticResource StepHeader}"/>
                        <TextBlock x:Name="SourceCountText" Text="" Style="{StaticResource SecondaryLabel}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,7">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ChatSourceCombo" Grid.Column="0" SelectionChanged="ChatSourceCombo_SelectionChanged"
                                      Height="28" FontSize="12">
                                <ComboBoxItem Content="Live FiveM session"/>
                                <ComboBoxItem Content="Chat log backup file..."/>
                                <ComboBoxItem Content="Pasted text"/>
                            </ComboBox>
                            <Button x:Name="ReloadSourceBtn" Grid.Column="1" Click="ReloadSourceBtn_Click"
                                    Height="28" Width="30" Margin="4,0,0,0" ToolTip="Reload from the current source">
                                <iconPacks:PackIconMaterial Kind="Refresh" Width="13" Height="13"/>
                            </Button>
                        </Grid>

                        <Grid x:Name="SearchFilterGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="ChatSearchTextBox" Grid.Row="0" Height="27" VerticalContentAlignment="Center" FontSize="12"
                                     Controls:TextBoxHelper.Watermark="Filter lines..."
                                     Controls:TextBoxHelper.ClearTextButton="True"
                                     TextChanged="ChatSearchTextBox_TextChanged" Margin="0,0,0,6"/>
                            <UniformGrid Grid.Row="1" Columns="4">
                                <RadioButton x:Name="FilterAllRadio" Content="All" IsChecked="True" Checked="FilterRadio_CheckedChanged" FontSize="11.5"/>
                                <RadioButton x:Name="FilterMeDoRadio" Content="/me &amp; /do" Checked="FilterRadio_CheckedChanged" FontSize="11.5"/>
                                <RadioButton x:Name="FilterDialogueRadio" Content="Speech" Checked="FilterRadio_CheckedChanged" FontSize="11.5"/>
                                <RadioButton x:Name="FilterRadioRadio" Content="Radio" Checked="FilterRadio_CheckedChanged" FontSize="11.5"/>
                            </UniformGrid>
                        </Grid>
                        <Border x:Name="ColorSourceBanner" Margin="0,7,0,0"
                                Background="{DynamicResource ScreenshotBannerFill}" BorderBrush="{DynamicResource ScreenshotBannerBorder}" BorderThickness="1" CornerRadius="4"
                                Padding="7,4" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial x:Name="ColorSourceIcon" Kind="InformationOutline" Width="12" Height="12"
                                                            VerticalAlignment="Top" Margin="0,2,7,0"/>
                                <TextBlock x:Name="ColorSourceText" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Text}"
                                           TextWrapping="Wrap" MaxWidth="330"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource PaneBody}" Margin="0,0,0,7">
                        <Grid>
                            <!-- Lines are previewed on a dark ground at their true chat colour, so the
                                 list reads like the game rather than like a spreadsheet. -->
                            <ListBox x:Name="ChatLinesListBox" SelectionMode="Extended"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"
                                     Background="{DynamicResource ScreenshotChatSurface}" BorderThickness="0" Padding="2">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="2"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="2,0,7,0"/>

                                            <!-- Color indicator square -->
                                            <Border Grid.Column="1" Width="13" Height="13" CornerRadius="3"
                                                    Background="{Binding ColorBrush}" BorderBrush="#55FFFFFF" BorderThickness="1"
                                                    Margin="0,0,7,0" VerticalAlignment="Center"
                                                    ToolTip="{Binding SourceTooltip}"/>

                                            <TextBlock Grid.Column="2" TextWrapping="Wrap" FontSize="11.5"
                                                       VerticalAlignment="Center" Margin="0,1"
                                                       Controls:TextBoxHelper.AutoWatermark="False"
                                                       Text="{Binding DisplayText}" Foreground="{Binding ColorBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBox x:Name="CustomChatTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="7"
                                     BorderThickness="0" FontSize="12" Background="{DynamicResource ScreenshotChatSurface}"
                                     Controls:TextBoxHelper.Watermark="Paste chat lines here — timestamps are stripped automatically."/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="SelectAllLinesBtn" Click="SelectAllLinesBtn_Click" Content="All" Height="28" Padding="11,0" Margin="0,0,4,0" FontSize="11.5" ToolTip="Tick every visible line"/>
                            <Button x:Name="DeselectAllLinesBtn" Click="DeselectAllLinesBtn_Click" Content="None" Height="28" Padding="11,0" FontSize="11.5" ToolTip="Untick every visible line"/>
                        </StackPanel>
                        <Button x:Name="AddSelectedLinesBtn" Grid.Column="2" Click="AddSelectedLinesBtn_Click"
                                Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" Height="28" Padding="13,0" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Add to canvas" Margin="0,0,6,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <iconPacks:PackIconMaterial Kind="ArrowDownBold" Width="12" Height="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                              Background="Transparent" Cursor="SizeNS"/>

                <!-- STEP 2 : ARRANGE -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,7">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Border Style="{StaticResource StepNumber}">
                                <TextBlock Text="2" Foreground="White" FontSize="10.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="On the canvas" Style="{StaticResource StepHeader}"/>
                            <TextBlock x:Name="PlacedCountText" Text="" Style="{StaticResource SecondaryLabel}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="MoveLineUpBtn" Click="MoveLineUpBtn_Click" Width="26" Height="26" Padding="0" Margin="0,0,3,0" ToolTip="Move the selected line up">
                                <iconPacks:PackIconMaterial Kind="ArrowUp" Width="11" Height="11"/>
                            </Button>
                            <Button x:Name="MoveLineDownBtn" Click="MoveLineDownBtn_Click" Width="26" Height="26" Padding="0" Margin="0,0,3,0" ToolTip="Move the selected line down">
                                <iconPacks:PackIconMaterial Kind="ArrowDown" Width="11" Height="11"/>
                            </Button>
                            <Button x:Name="AddCustomLineBtn" Click="AddCustomLineBtn_Click" Width="26" Height="26" Padding="0" Margin="0,0,3,0" ToolTip="Add a blank line">
                                <iconPacks:PackIconMaterial Kind="Plus" Width="11" Height="11"/>
                            </Button>
                            <Button x:Name="ClearAllPlacedLinesBtn" Click="ClearAllPlacedLinesBtn_Click" Width="26" Height="26" Padding="0"
                                    Foreground="{DynamicResource ScreenshotDanger}" ToolTip="Remove every line from the canvas">
                                <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="12" Height="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource PaneBody}">
                        <Grid>
                            <ListBox x:Name="PlacedLinesListBox" SelectionChanged="PlacedLinesListBox_SelectionChanged"
                                     Background="{DynamicResource ScreenshotChatSurface}" BorderThickness="0" Padding="2"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="2"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Clickable Color Square with Dropdown -->
                                            <Button Grid.Column="0" Click="LineColorSquare_Click"
                                                    Width="20" Height="20" Margin="1,0,6,0" Padding="0"
                                                    ToolTip="{Binding SourceTooltip}"
                                                    Cursor="Hand" Style="{DynamicResource MahApps.Styles.Button.Flat}">
                                                <Border Width="15" Height="15" CornerRadius="3" Background="{Binding ColorBrush}"
                                                        BorderBrush="#66FFFFFF" BorderThickness="1"/>
                                            </Button>

                                            <TextBox Grid.Column="1" Text="{Binding RawText, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="PlacedLineText_Changed"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{Binding ColorBrush}"
                                                     FontSize="11.5" VerticalAlignment="Center" Margin="0,0,4,0"/>

                                            <Button Grid.Column="2" Click="DeletePlacedLine_Click" Width="20" Height="20" Padding="0"
                                                    Foreground="{DynamicResource MahApps.Brushes.Gray3}" ToolTip="Delete this line"
                                                    Style="{DynamicResource MahApps.Styles.Button.Flat}">
                                                <iconPacks:PackIconMaterial Kind="Close" Width="10" Height="10"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="PlacedEmptyHint" IsHitTestVisible="False"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="11.5" TextAlignment="Center"
                                       Text="Nothing placed yet.&#x0a;Tick lines above and press Add to canvas."/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- STEP 3 : STYLE — collapsed by default; it is tuned once, not per line. -->
                <Expander Grid.Row="3" x:Name="StyleExpander" IsExpanded="False" Margin="0,6,0,0">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource StepNumber}">
                                <TextBlock Text="3" Foreground="White" FontSize="10.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Style &amp; position" Style="{StaticResource StepHeader}"/>
                        </StackPanel>
                    </Expander.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="290" Margin="0,8,0,0">
                        <StackPanel Margin="2,0,6,2">

                            <TextBlock Text="Anchor the chat block" Style="{StaticResource SecondaryLabel}" Margin="0,0,0,4"/>
                            <UniformGrid Columns="4" Margin="0,0,0,8">
                                <Button Content="↖" Click="AnchorTopLeft_Click" Height="26" Margin="0,0,2,0" FontSize="13" ToolTip="Top left"/>
                                <Button Content="↗" Click="AnchorTopRight_Click" Height="26" Margin="2,0,2,0" FontSize="13" ToolTip="Top right"/>
                                <Button Content="↙" Click="AnchorBottomLeft_Click" Height="26" Margin="2,0,2,0" FontSize="13" ToolTip="Bottom left"/>
                                <Button Content="↘" Click="AnchorBottomRight_Click" Height="26" Margin="2,0,0,0" FontSize="13" ToolTip="Bottom right"/>
                            </UniformGrid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="X" Style="{StaticResource SecondaryLabel}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="ChatXTextBox" Text="30" TextChanged="ChatPosition_TextChanged" Height="26" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Y" Style="{StaticResource SecondaryLabel}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="ChatYTextBox" Text="30" TextChanged="ChatPosition_TextChanged" Height="26" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Font" Style="{StaticResource SecondaryLabel}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="FontFamilyCombo" SelectionChanged="Styling_Changed" Height="27" Margin="0,0,0,9" FontSize="12">
                                <ComboBoxItem Content="Arial"/>
                                <ComboBoxItem Content="Segoe UI"/>
                                <ComboBoxItem Content="Tahoma"/>
                                <ComboBoxItem Content="Trebuchet MS"/>
                                <ComboBoxItem Content="Verdana"/>
                                <ComboBoxItem Content="Georgia"/>
                                <ComboBoxItem Content="Impact"/>
                            </ComboBox>

                            <Grid Margin="0,0,0,1">
                                <TextBlock Text="Size" Style="{StaticResource SecondaryLabel}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="FontSizeValText" Text="14" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                            </Grid>
                            <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="34" Value="14" ValueChanged="StylingSlider_ValueChanged" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,1">
                                <TextBlock Text="Line spacing" Style="{StaticResource SecondaryLabel}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="LineSpacingValText" Text="4" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                            </Grid>
                            <Slider x:Name="LineSpacingSlider" Minimum="0" Maximum="16" Value="4" ValueChanged="StylingSlider_ValueChanged" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,1">
                                <TextBlock Text="Outline" Style="{StaticResource SecondaryLabel}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="OutlineWidthValText" Text="1.2" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                            </Grid>
                            <Slider x:Name="OutlineWidthSlider" Minimum="0" Maximum="3.0" Value="1.2" SmallChange="0.1" ValueChanged="StylingSlider_ValueChanged" Margin="0,0,0,8"/>

                            <CheckBox x:Name="FontBoldCheck" Content="Bold" IsChecked="True" Checked="Styling_Changed" Unchecked="Styling_Changed" FontSize="12" Margin="0,0,0,5"/>
                            <CheckBox x:Name="DropShadowCheck" Content="Drop shadow" IsChecked="True" Checked="Styling_Changed" Unchecked="Styling_Changed" FontSize="12" Margin="0,0,0,5"/>
                            <CheckBox x:Name="EnableBgBoxCheck" Content="Dark backing box" IsChecked="False" Checked="Styling_Changed" Unchecked="Styling_Changed" FontSize="12" Margin="0,0,0,5"/>

                            <Grid Margin="0,0,0,1">
                                <TextBlock Text="Box opacity" Style="{StaticResource SecondaryLabel}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="BgBoxOpacityValText" Text="0.45" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                            </Grid>
                            <Slider x:Name="BgBoxOpacitySlider" Minimum="0.1" Maximum="0.9" Value="0.45" SmallChange="0.05" ValueChanged="StylingSlider_ValueChanged"/>

                        </StackPanel>
                    </ScrollViewer>
                </Expander>
            </Grid>
        </Grid>

        <!-- ============ STATUS STRIP ============ -->
        <Border Grid.Row="2" Background="{DynamicResource MahApps.Brushes.Gray10}"
                BorderBrush="{DynamicResource MahApps.Brushes.Separator}" BorderThickness="0,1,0,0" Padding="11,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="StatusInfoText" Text="Ready." HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontSize="11.5" Foreground="{DynamicResource MahApps.Brushes.Gray2}"/>
                <TextBlock x:Name="CanvasStatsText" Text="1300 × 730" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
            </Grid>
        </Border>
    </Grid>
</Controls:MetroWindow>
