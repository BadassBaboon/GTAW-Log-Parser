<Controls:MetroWindow x:Class="Assistant.UI.ScreenshotEditorWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                      xmlns:local="clr-namespace:Assistant.UI"
                      mc:Ignorable="d"
                      Title="Screenshot Editor"
                      TitleCharacterCasing="Normal"
                      Height="880" Width="1400"
                      MinWidth="1100" MinHeight="720"
                      WindowStartupLocation="CenterOwner"
                      GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                      ShowIconOnTitleBar="False"
                      Icon="pack://application:,,,/GTAWAssistant;component/Resources/AppIcon.ico"
                      KeyDown="MetroWindow_KeyDown">

    <Window.Resources>

        <!-- A numbered step header, so the left-to-right workflow is legible without tab hunting. -->
        <Style x:Key="StepHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SecondaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToolbarSegment" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Separator}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- Standard transparency checkerboard. Two 8px squares in a 16px tile; the tones are
             swapped at runtime for light mode so the pattern stays legible either way. -->
        <DrawingBrush x:Key="CheckerboardBrush" TileMode="Tile"
                      Viewport="0,0,16,16" ViewportUnits="Absolute"
                      Stretch="None" RenderOptions.CachingHint="Cache">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource ScreenshotCheckerLight}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{DynamicResource ScreenshotCheckerDark}">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8"/>
                                <RectangleGeometry Rect="8,8,8,8"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="PaneBody" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Separator}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>

        <!-- Compact section expander that places the drop-down chevron directly next to the header text without huge gaps -->
        <Style x:Key="CompactSectionExpander" TargetType="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderButton" DockPanel.Dock="Top"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                                              HorizontalAlignment="Left">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="0,3">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ContentPresenter ContentSource="Content" Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                                                    <iconPacks:PackIconMaterial x:Name="ExpandArrow" Kind="ChevronDown" Width="13" Height="13"
                                                                                Margin="6,1,0,0" VerticalAlignment="Center"
                                                                                Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ExpandArrow" Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ExpandArrow" Property="Kind" Value="ChevronUp"/>
                                                    <Setter TargetName="ExpandArrow" Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter ContentSource="Header"/>
                                </ToggleButton>

                                <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom"
                                                  ContentSource="Content"
                                                  Visibility="Collapsed"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ============ TOP COMMAND BAR ============ -->
        <Border Grid.Row="0" Background="{DynamicResource MahApps.Brushes.Gray10}"
                BorderBrush="{DynamicResource MahApps.Brushes.Separator}" BorderThickness="0,0,0,1" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource ToolbarSegment}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="OpenImageBtn" Click="OpenImageBtn_Click" Height="27" Padding="9,0" Margin="0,0,2,0" ToolTip="Open an image (Ctrl+O)">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FolderImage" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Open" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PasteImageBtn" Click="PasteImageBtn_Click" Height="27" Padding="9,0" ToolTip="Paste an image from the clipboard (Ctrl+V)">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ClipboardOutline" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Paste" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ToolbarSegment}" Padding="7,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="AspectRatio" Width="13" Height="13" Margin="0,0,7,0"
                                                        Foreground="{DynamicResource MahApps.Brushes.Gray3}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ResolutionPresetCombo" SelectionChanged="ResolutionPresetCombo_SelectionChanged"
                                      Width="200" Height="25" FontSize="12" Margin="0,0,8,0"/>
                            <TextBox x:Name="CanvasWidthTextBox" Text="1300" Width="46" Height="25" TextAlignment="Center"
                                     VerticalContentAlignment="Center" TextChanged="CanvasDimensions_TextChanged" ToolTip="Canvas width in pixels"/>
                            <TextBlock Text="×" Margin="5,0" VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                            <TextBox x:Name="CanvasHeightTextBox" Text="730" Width="46" Height="25" TextAlignment="Center"
                                     VerticalContentAlignment="Center" TextChanged="CanvasDimensions_TextChanged" ToolTip="Canvas height in pixels"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ToolbarSegment}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="AspectFitBtn" Click="AspectFitBtn_Click" Content="Fit" Height="25" Padding="9,0" Margin="0,0,2,0" FontSize="11.5" ToolTip="Scale the image to fit inside the canvas"/>
                            <Button x:Name="AspectFillBtn" Click="AspectFillBtn_Click" Content="Fill" Height="25" Padding="9,0" Margin="0,0,2,0" FontSize="11.5" ToolTip="Scale the image to cover the canvas"/>
                            <Button x:Name="ResetViewBtn" Click="ResetViewBtn_Click" Content="Reset" Height="25" Padding="9,0" Margin="0,0,6,0" FontSize="11.5" ToolTip="Reset pan and zoom to 100%"/>

                            <Rectangle Width="1" Height="16" Fill="{DynamicResource MahApps.Brushes.Separator}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                            <iconPacks:PackIconMaterial Kind="Magnify" Width="13" Height="13" Margin="0,0,5,0"
                                                        Foreground="{DynamicResource MahApps.Brushes.Gray3}" VerticalAlignment="Center"/>
                            <Slider x:Name="ZoomSlider" Minimum="10" Maximum="400" Value="100" Width="85" Height="20"
                                    VerticalAlignment="Center" Margin="0,0,5,0"
                                    ValueChanged="ZoomSlider_ValueChanged"
                                    ToolTip="Zoom image manually (10% to 400%)"/>
                            <TextBlock x:Name="ZoomValText" Text="100%" Width="36" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MahApps.Brushes.Gray3}" TextAlignment="Right" Margin="0,0,3,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CopyToClipboardBtn" Click="CopyToClipboardBtn_Click"
                            Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                            Height="31" Padding="13,0" Margin="0,0,8,0" ToolTip="Copy the rendered image to the clipboard (Ctrl+Shift+C)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentCopy" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Copy Image" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SaveImageBtn" Click="SaveImageBtn_Click" Height="31" Padding="12,0" ToolTip="Save rendered image to disk (PNG or JPEG)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Download" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Save Image" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ WORKSPACE ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="430" MinWidth="380" MaxWidth="620"/>
            </Grid.ColumnDefinitions>

            <!-- CANVAS VIEWPORT -->
            <Grid x:Name="ViewportSurface" Grid.Column="0" ClipToBounds="True"
                  MouseDown="Viewport_MouseDown" MouseMove="Viewport_MouseMove"
                  MouseUp="Viewport_MouseUp" MouseWheel="Viewport_MouseWheel">

                <Grid x:Name="ViewportGrid" HorizontalAlignment="Center" VerticalAlignment="Center"
                      SizeChanged="ViewportGrid_SizeChanged">
                    <Border x:Name="CanvasFrame" CornerRadius="3" Margin="-6">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Opacity="0.7"/>
                        </Border.Effect>
                    </Border>

                    <!-- Sits behind the rendered bitmap and is exactly its size, so any canvas the
                         image no longer covers reads as transparent rather than as black padding. -->
                    <Rectangle x:Name="CheckerboardLayer" Fill="{StaticResource CheckerboardBrush}"
                               Width="{Binding ActualWidth, ElementName=CanvasPreviewImage}"
                               Height="{Binding ActualHeight, ElementName=CanvasPreviewImage}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <Image x:Name="CanvasPreviewImage" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Selection adorner. Drawn as live WPF chrome rather than baked into the
                         bitmap, so what you export never contains the editing outline. -->
                    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" ClipToBounds="True">
                        <Rectangle x:Name="ChatBlockOutline" Visibility="Collapsed"
                                   Stroke="{DynamicResource MahApps.Brushes.Accent}" StrokeThickness="1"
                                   Fill="{DynamicResource ScreenshotSelectionFill}" RadiusX="2" RadiusY="2">
                            <Rectangle.StrokeDashArray>
                                <DoubleCollection>3 2</DoubleCollection>
                            </Rectangle.StrokeDashArray>
                        </Rectangle>
                    </Canvas>
                </Grid>

                <!-- Empty state: says what to do, instead of showing a blank black rectangle. -->
                <Border x:Name="EmptyStateHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource ScreenshotOverlayFill}" BorderBrush="{DynamicResource ScreenshotOverlayBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="26,20" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="ImagePlus" Width="26" Height="26" HorizontalAlignment="Center"
                                                    Foreground="{DynamicResource ScreenshotOverlayMuted}" Margin="0,0,0,10"/>
                        <TextBlock Text="Drop in a screenshot to begin" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ScreenshotOverlayText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Open, or paste with Ctrl+V" FontSize="11.5"
                                   Foreground="{DynamicResource ScreenshotOverlayMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                        Background="{DynamicResource ScreenshotOverlayFill}" BorderBrush="{DynamicResource ScreenshotOverlayBorder}" BorderThickness="1"
                        CornerRadius="5" Padding="8,5" IsHitTestVisible="False">
                    <TextBlock x:Name="ViewportHintText" FontSize="11" Foreground="{DynamicResource ScreenshotOverlayText}"
                               Text="Drag the chat block to move it · Right-drag to pan · Wheel to zoom"/>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource MahApps.Brushes.Separator}" Cursor="SizeWE"/>

            <!-- INSPECTOR -->
            <Grid Grid.Column="2" Margin="8,8,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CHAT LINES (Unified single section) -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,7">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <CheckBox x:Name="AutoColorCheckBox" Content="Auto color"
                                      IsChecked="True" VerticalAlignment="Center" FontSize="11.5"
                                      ToolTip="Automatically detect and color roleplay lines on import or paste. When unchecked, lines are plain white."/>
                            <TextBlock x:Name="PlacedCountText" Text="" Style="{StaticResource SecondaryLabel}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ImportChatlogBtn" Click="ImportChatlogBtn_Click" Height="26" Padding="8,0" Margin="0,0,4,0"
                                    FontSize="11.5" ToolTip="Import lines from a chatlog file">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Import chatlog" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PasteChatBtn" Click="PasteChatBtn_Click" Height="26" Padding="8,0" Margin="0,0,4,0"
                                    FontSize="11.5" ToolTip="Paste chat lines from clipboard (Ctrl+V)">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ContentPaste" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Paste" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="AddCustomLineBtn" Click="AddCustomLineBtn_Click" Width="26" Height="26" Padding="0" Margin="0,0,4,0"
                                    ToolTip="Add a blank line below selected or at the end">
                                <iconPacks:PackIconMaterial Kind="Plus" Width="11" Height="11"/>
                            </Button>
                            <Button x:Name="ClearAllPlacedLinesBtn" Click="ClearAllPlacedLinesBtn_Click" Width="26" Height="26" Padding="0"
                                    Foreground="{DynamicResource ScreenshotDanger}" ToolTip="Clear all chat lines">
                                <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="12" Height="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource PaneBody}">
                        <Grid>
                            <ListBox x:Name="PlacedLinesListBox"
                                     AllowDrop="True"
                                     KeyDown="PlacedLinesListBox_KeyDown"
                                     PreviewMouseMove="PlacedLinesListBox_PreviewMouseMove"
                                     DragOver="PlacedLinesListBox_DragOver"
                                     Drop="PlacedLinesListBox_Drop"
                                     Background="{DynamicResource ScreenshotChatSurface}" BorderThickness="0" Padding="2"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="2"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Drag Grip Handle -->
                                            <Border Grid.Column="0" Cursor="SizeAll" Background="Transparent"
                                                    Width="14" Height="18" Margin="0,0,3,0"
                                                    PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                                    ToolTip="Drag to reorder">
                                                <iconPacks:PackIconMaterial Kind="DragVertical" Width="11" Height="11"
                                                                            Foreground="{DynamicResource ScreenshotChatMuted}"
                                                                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>

                                            <!-- Clickable Color Square with Dropdown -->
                                            <Button Grid.Column="1" Click="LineColorSquare_Click" Focusable="False"
                                                    Width="13" Height="13" Margin="2,0,7,0" Padding="0"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" ToolTip="{Binding SourceTooltip}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Width="13" Height="13" CornerRadius="3"
                                                                Background="{Binding ColorBrush}"
                                                                BorderBrush="{DynamicResource ScreenshotSwatchBorder}" BorderThickness="1"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Multi-color editable line with text selection recolor support -->
                                            <RichTextBox Grid.Column="2"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Padding="0"
                                                         Margin="0,0,4,0"
                                                         VerticalAlignment="Center"
                                                         FontSize="11.5"
                                                         Foreground="{DynamicResource ScreenshotChatText}"
                                                         CaretBrush="{DynamicResource ScreenshotChatText}"
                                                         IsInactiveSelectionHighlightEnabled="True"
                                                         AcceptsReturn="False"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                         local:RichChatLineHelper.PlacedLine="{Binding}"
                                                         PreviewKeyDown="PlacedLineRichText_PreviewKeyDown"
                                                         TextChanged="PlacedLineRichText_Changed">
                                                <RichTextBox.Resources>
                                                    <Style TargetType="{x:Type FlowDocument}">
                                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                        <Setter Property="PagePadding" Value="0"/>
                                                    </Style>
                                                    <Style TargetType="{x:Type Paragraph}">
                                                        <Setter Property="Margin" Value="0"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="LineHeight" Value="1"/>
                                                    </Style>
                                                </RichTextBox.Resources>
                                            </RichTextBox>

                                            <Button Grid.Column="3" Click="DeletePlacedLine_Click" Focusable="False" Width="18" Height="18" Padding="0"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource ScreenshotChatMuted}" ToolTip="Delete this line"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" CornerRadius="3">
                                                            <iconPacks:PackIconMaterial Kind="Close" Width="10" Height="10"
                                                                                        Foreground="{TemplateBinding Foreground}"
                                                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ScreenshotDanger}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="PlacedEmptyHint" IsHitTestVisible="False"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ScreenshotChatMuted}" FontSize="11.5" TextAlignment="Center"
                                       Text="No chat lines yet.&#x0a;Click Paste, Import chatlog, or + to add a line."/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- STYLE AND POSITION -->
                <Expander Grid.Row="1" x:Name="StyleExpander" Style="{StaticResource CompactSectionExpander}" IsExpanded="False" Margin="0,6,0,0">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="TuneVertical" Width="14" Height="14" Margin="0,0,7,0"
                                                        Foreground="{DynamicResource MahApps.Brushes.Accent}" VerticalAlignment="Center"/>
                            <TextBlock Text="Style &amp; position" Style="{StaticResource StepHeader}"/>
                        </StackPanel>
                    </Expander.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320" Margin="0,6,0,0">
                        <StackPanel Margin="2,2,6,4">

                            <!-- SECTION: POSITION & ANCHORS -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 2x2 Corner Snap Buttons -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Corner snap" Style="{StaticResource SecondaryLabel}" Margin="0,0,0,3"/>
                                    <Grid Width="58" Height="52">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Row="0" Grid.Column="0" Content="↖" Click="AnchorTopLeft_Click" Margin="0,0,1,1" FontSize="11.5" ToolTip="Snap top-left"/>
                                        <Button Grid.Row="0" Grid.Column="1" Content="↗" Click="AnchorTopRight_Click" Margin="1,0,0,1" FontSize="11.5" ToolTip="Snap top-right"/>
                                        <Button Grid.Row="1" Grid.Column="0" Content="↙" Click="AnchorBottomLeft_Click" Margin="0,1,1,0" FontSize="11.5" ToolTip="Snap bottom-left"/>
                                        <Button Grid.Row="1" Grid.Column="1" Content="↘" Click="AnchorBottomRight_Click" Margin="1,1,0,0" FontSize="11.5" ToolTip="Snap bottom-right"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Position X & Y Inputs -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock Text="Position offset (px)" Style="{StaticResource SecondaryLabel}" Margin="0,0,0,3"/>
                                    <Grid Margin="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="X" FontSize="10" Foreground="{DynamicResource MahApps.Brushes.Gray2}" Margin="1,0,0,1"/>
                                            <TextBox x:Name="ChatXTextBox" Text="30" TextChanged="ChatPosition_TextChanged" Height="25" VerticalContentAlignment="Center" FontSize="11.5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Y" FontSize="10" Foreground="{DynamicResource MahApps.Brushes.Gray2}" Margin="1,0,0,1"/>
                                            <TextBox x:Name="ChatYTextBox" Text="30" TextChanged="ChatPosition_TextChanged" Height="25" VerticalContentAlignment="Center" FontSize="11.5"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Separator Background="{DynamicResource MahApps.Brushes.Separator}" Margin="0,0,0,8"/>

                            <!-- SECTION: FONT & SIZE -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Font family" Style="{StaticResource SecondaryLabel}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="FontFamilyCombo" SelectionChanged="Styling_Changed" Height="26" FontSize="11.5">
                                        <ComboBoxItem Content="Arial"/>
                                        <ComboBoxItem Content="Segoe UI"/>
                                        <ComboBoxItem Content="Tahoma"/>
                                        <ComboBoxItem Content="Trebuchet MS"/>
                                        <ComboBoxItem Content="Verdana"/>
                                        <ComboBoxItem Content="Georgia"/>
                                        <ComboBoxItem Content="Impact"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Size" Style="{StaticResource SecondaryLabel}" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="FontSizeValText" Text="14" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                                    </Grid>
                                    <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="34" Value="14" ValueChanged="StylingSlider_ValueChanged" Height="26"/>
                                </StackPanel>
                            </Grid>

                            <!-- SECTION: LINE SPACING & OUTLINE -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Line spacing" Style="{StaticResource SecondaryLabel}" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="LineSpacingValText" Text="4" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                                    </Grid>
                                    <Slider x:Name="LineSpacingSlider" Minimum="0" Maximum="16" Value="4" ValueChanged="StylingSlider_ValueChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Outline" Style="{StaticResource SecondaryLabel}" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="OutlineWidthValText" Text="1.2" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                                    </Grid>
                                    <Slider x:Name="OutlineWidthSlider" Minimum="0" Maximum="3.0" Value="1.2" SmallChange="0.1" ValueChanged="StylingSlider_ValueChanged"/>
                                </StackPanel>
                            </Grid>

                            <Separator Background="{DynamicResource MahApps.Brushes.Separator}" Margin="0,0,0,8"/>

                            <!-- SECTION: EFFECTS & BOX -->
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <CheckBox x:Name="FontBoldCheck" Content="Bold" IsChecked="True" Checked="Styling_Changed" Unchecked="Styling_Changed"
                                          FontSize="11.5" Margin="0,0,16,4"/>
                                <CheckBox x:Name="DropShadowCheck" Content="Drop shadow" IsChecked="True" Checked="Styling_Changed" Unchecked="Styling_Changed"
                                          FontSize="11.5" Margin="0,0,16,4"/>
                                <CheckBox x:Name="EnableBgBoxCheck" Content="Backing box" IsChecked="False" Checked="Styling_Changed" Unchecked="Styling_Changed"
                                          FontSize="11.5" Margin="0,0,0,4"/>
                            </WrapPanel>

                            <Grid Margin="0,0,0,2" IsEnabled="{Binding IsChecked, ElementName=EnableBgBoxCheck}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Box opacity" Style="{StaticResource SecondaryLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BgBoxOpacityValText" Text="0.45" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                                <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="BgBoxOpacitySlider" Minimum="0.1" Maximum="0.9" Value="0.45" SmallChange="0.05"
                                        ValueChanged="StylingSlider_ValueChanged" Margin="0,2,0,0"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Expander>
            </Grid>
        </Grid>

        <!-- ============ STATUS STRIP ============ -->
        <Border Grid.Row="2" Background="{DynamicResource MahApps.Brushes.Gray10}"
                BorderBrush="{DynamicResource MahApps.Brushes.Separator}" BorderThickness="0,1,0,0" Padding="11,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="StatusInfoText" Text="Ready." HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontSize="11.5" Foreground="{DynamicResource MahApps.Brushes.Gray2}"/>
                <TextBlock x:Name="CanvasStatsText" Text="1300 × 730" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
            </Grid>
        </Border>
    </Grid>
</Controls:MetroWindow>
