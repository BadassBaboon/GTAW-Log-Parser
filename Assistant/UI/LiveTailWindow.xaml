<Controls:MetroWindow x:Name="LiveTail" x:Class="Assistant.UI.LiveTailWindow"
                      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:local="clr-namespace:Assistant.UI"
                      mc:Ignorable="d"
                      WindowStartupLocation="CenterScreen"
                      ResizeMode="CanResize"
                      Loaded="LiveTail_Loaded"
                      Closing="LiveTail_Closing"
                      KeyDown="LiveTail_KeyDown"
                      BorderThickness="0"
                      GlowBrush="Black"
                      Title="Live Tail" Height="500" Width="700"
                      MinHeight="300" MinWidth="500"
                      IsMaxRestoreButtonEnabled="True" IsMinButtonEnabled="True"
                      TitleCharacterCasing="Normal" ShowIconOnTitleBar="False"
                      Icon="pack://application:,,,/GTAWAssistant;component/Resources/AppIcon.ico">

    <DockPanel Margin="10">
        <!-- Top Toolbar -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <!-- Search Bar Row -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Grid.Column="0" Height="26" VerticalContentAlignment="Center"
                         Controls:TextBoxHelper.Watermark="Search in logs (Ctrl+F)..."
                         Controls:TextBoxHelper.ClearTextButton="False"
                         TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>

                <TextBlock x:Name="SearchMatchCount" Grid.Column="1" Text="0/0"
                           TextAlignment="Center" VerticalAlignment="Center" Margin="4,0,4,0"
                           Foreground="{DynamicResource MahApps.Brushes.Gray}" FontSize="11"/>

                <Button x:Name="SearchPrevBtn" Grid.Column="2" Content="▲" Width="28" Height="26" IsEnabled="False"
                        Click="SearchPrevBtn_Click" ToolTip="Previous match (Shift+Enter / Shift+F3)"/>

                <Button x:Name="SearchNextBtn" Grid.Column="3" Content="▼" Width="28" Height="26" Margin="4,0,4,0" IsEnabled="False"
                        Click="SearchNextBtn_Click" ToolTip="Next match (Enter / F3)"/>

                <Button x:Name="SearchClearBtn" Grid.Column="4" Content="✕" Width="28" Height="26" IsEnabled="False"
                        Click="SearchClearBtn_Click" ToolTip="Clear search (Esc)"/>
            </Grid>

            <!-- Actions & Options Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label x:Name="StatusLabel" Grid.Column="0" Content="Idle" VerticalAlignment="Center" FontWeight="DemiBold"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ColoredText" Content="Colored text" IsChecked="True"
                              VerticalAlignment="Center" Margin="0,0,14,0"
                              Checked="ColoredText_CheckedChanged" Unchecked="ColoredText_CheckedChanged"
                              ToolTip="Display log lines with GTA World roleplay colors"/>

                    <CheckBox x:Name="RemoveTimestamps" Content="Remove timestamps"
                              VerticalAlignment="Center" Margin="0,0,14,0"
                              Checked="RemoveTimestamps_CheckedChanged" Unchecked="RemoveTimestamps_CheckedChanged"
                              ToolTip="Hide leading timestamps from log display"/>

                    <CheckBox x:Name="WordWrapCheck" Content="Word wrap" IsChecked="True"
                              VerticalAlignment="Center" Margin="0,0,14,0"
                              Checked="WordWrap_CheckedChanged" Unchecked="WordWrap_CheckedChanged"
                              ToolTip="Wrap long chat lines to window width (uncheck for single-line horizontal scrolling)"/>

                    <CheckBox x:Name="AutoScroll" Content="Auto-scroll" IsChecked="True"
                              VerticalAlignment="Center" Margin="0,0,14,0"
                              ToolTip="Automatically scroll down when new chat messages arrive"/>

                    <Button x:Name="ToggleWatch" Content="Start" Width="70" Height="26" Click="ToggleWatch_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Bottom Status and Action Bar -->
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Counter" Grid.Column="0" Text="0 characters and 0 lines" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CopyAllButton" Content="Copy All" Width="75" Height="26" Margin="0,0,6,0" Click="CopyAllButton_Click" ToolTip="Copy all visible log text to clipboard"/>
                <Button x:Name="ClearButton" Content="Clear" Width="75" Height="26" Click="ClearButton_Click" ToolTip="Clear the current display buffer"/>
            </StackPanel>
        </Grid>

        <!-- Main Formatted Rich Log Viewer -->
        <Border x:Name="TailContainer" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" BorderThickness="1" CornerRadius="4" Background="#18191C">
            <RichTextBox x:Name="TailRich" IsReadOnly="True" AcceptsReturn="False" IsUndoEnabled="False"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         FontFamily="Consolas" FontSize="12" Padding="10,8"
                         Background="Transparent"
                         Foreground="#FFFFFF"
                         CaretBrush="#FFFFFF"
                         BorderThickness="0" SelectionChanged="TailRich_SelectionChanged"/>
        </Border>
    </DockPanel>
</Controls:MetroWindow>
