<Controls:MetroWindow x:Class="Assistant.UI.AiModelInfoWindow"
                      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      WindowStartupLocation="CenterOwner"
                      ResizeMode="NoResize"
                      BorderThickness="0"
                      GlowBrush="Black"
                      Title="AI Models &amp; Parameter Guide"
                      Height="580" Width="680"
                      ShowInTaskbar="False"
                      IsMinButtonEnabled="False"
                      IsMaxRestoreButtonEnabled="False"
                      ShowIconOnTitleBar="False"
                      TitleCharacterCasing="Normal"
                      Icon="pack://application:,,,/GTAWAssistant;component/Resources/AppIcon.ico">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Scrollable Content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>
                <!-- GroupBox 1: Models -->
                <GroupBox Header="Available GroqCloud Models" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <!-- Model 1: GPT-OSS 20B -->
                        <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" CornerRadius="4" Padding="10" Background="{DynamicResource MahApps.Brushes.Background}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Top Bar: Name & Speed Badge -->
                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock Text="openai/gpt-oss-20b" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                                        <Border Background="#1B5E20" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Recommended / Default" FontSize="10" FontWeight="Bold" Foreground="#81C784"/>
                                        </Border>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="#0D47A1" CornerRadius="3" Padding="5,1">
                                        <TextBlock Text="⚡ ~30–50 ms" FontSize="10" FontWeight="Bold" Foreground="#90CAF9"/>
                                    </Border>
                                </DockPanel>

                                <!-- Specs row -->
                                <TextBlock Grid.Row="1" Text="Daily Allowance: ~14,400 req/day | 500k tokens/min (Free Tier)" FontSize="11" Foreground="#007ACC" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                <!-- Description -->
                                <TextBlock Grid.Row="2" Text="Ultra-fast, lowest latency 20B model. Specially optimized for instantaneous clipboard text replacement, real-time accent conversion, fast translations, and grammar correction during active gameplay." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                            </Grid>
                        </Border>

                        <!-- Model 2: GPT-OSS 120B -->
                        <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" CornerRadius="4" Padding="10" Background="{DynamicResource MahApps.Brushes.Background}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock Text="openai/gpt-oss-120b" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                                        <Border Background="#4A148C" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="High Quality" FontSize="10" FontWeight="Bold" Foreground="#CE93D8"/>
                                        </Border>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="#0D47A1" CornerRadius="3" Padding="5,1">
                                        <TextBlock Text="🧠 ~60–90 ms" FontSize="10" FontWeight="Bold" Foreground="#90CAF9"/>
                                    </Border>
                                </DockPanel>

                                <TextBlock Grid.Row="1" Text="Daily Allowance: ~7,000 req/day | 250k tokens/min (Free Tier)" FontSize="11" Foreground="#007ACC" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="2" Text="Massive 120B parameter model with deep reasoning and rich vocabulary. Best suited for complex backstory analysis in the AI Profile Generator, sophisticated roleplay enrichments, and nuanced dialect voices." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                            </Grid>
                        </Border>

                        <!-- Model 3: Compound -->
                        <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" CornerRadius="4" Padding="10" Background="{DynamicResource MahApps.Brushes.Background}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock Text="groq/compound" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                                        <Border Background="#E65100" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Multi-Agent Router" FontSize="10" FontWeight="Bold" Foreground="#FFCC80"/>
                                        </Border>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="#37474F" CornerRadius="3" Padding="5,1">
                                        <TextBlock Text="🔄 ~400–600 ms" FontSize="10" FontWeight="Bold" Foreground="#CFD8DC"/>
                                    </Border>
                                </DockPanel>

                                <TextBlock Grid.Row="1" Text="Daily Allowance: Multi-Model Compound Routing" FontSize="11" Foreground="#007ACC" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="2" Text="Groq's compound AI architecture that routes prompts through multiple models to synthesize high-accuracy responses. Great for demanding tasks where multi-step evaluation is desired." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                            </Grid>
                        </Border>

                        <!-- Model 4: Compound Mini -->
                        <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" CornerRadius="4" Padding="10" Background="{DynamicResource MahApps.Brushes.Background}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock Text="groq/compound-mini" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                                        <Border Background="#37474F" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Lightweight Router" FontSize="10" FontWeight="Bold" Foreground="#CFD8DC"/>
                                        </Border>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="#37474F" CornerRadius="3" Padding="5,1">
                                        <TextBlock Text="⚡ ~350–500 ms" FontSize="10" FontWeight="Bold" Foreground="#CFD8DC"/>
                                    </Border>
                                </DockPanel>

                                <TextBlock Grid.Row="1" Text="Daily Allowance: Lightweight Compound Routing" FontSize="11" Foreground="#007ACC" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="2" Text="A faster, lighter variant of Groq Compound with lower token consumption while preserving multi-model verification accuracy." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- GroupBox 2: Parameters & Settings -->
                <GroupBox Header="Parameters &amp; Features" Margin="0,0,0,5">
                    <StackPanel Margin="8">
                        <!-- Temperature -->
                        <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" CornerRadius="4" Padding="10" Background="{DynamicResource MahApps.Brushes.Background}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Temperature Slider (0.0 – 1.0)" FontWeight="Bold" FontSize="12" Margin="0,0,0,3"/>
                                <TextBlock Text="Controls the model's creative variance. Lower values (e.g. 0.2) produce highly consistent, predictable, and faithful responses. Higher values (e.g. 0.7–0.9) grant the model more creative flair and vocabulary diversity." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                            </StackPanel>
                        </Border>

                        <!-- Phonetic Spelling -->
                        <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" CornerRadius="4" Padding="10" Background="{DynamicResource MahApps.Brushes.Background}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Phonetic Spelling" FontWeight="Bold" FontSize="12" Margin="0,0,0,3"/>
                                <TextBlock Text="When enabled, the model actively applies dialect spelling rules (such as dropping the ending 'g' on '-ing' words like 'talkin'', or writing sound spellings like 'dat' or 'ova'). When disabled, standard English grammar spelling is maintained while still altering vocabulary, tone, and syntax." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Enricher -->
                        <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" CornerRadius="4" Padding="10" Background="{DynamicResource MahApps.Brushes.Background}">
                            <StackPanel>
                                <TextBlock Text="Action Enricher" FontWeight="Bold" FontSize="12" Margin="0,0,0,3"/>
                                <TextBlock Text="Automatically detects GTA World roleplay actions (/me, /my, /do, /melow, /mylow, /dolow, etc.). When enabled, triggering your shortcut enriches simple action text into vivid, atmospheric descriptions with strict anti-hallucination guardrails and proper sentence punctuation." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CloseBtn" Content="Close" Width="90" Height="28" Click="CloseBtn_Click"/>
        </StackPanel>
    </Grid>
</Controls:MetroWindow>
