<Controls:MetroWindow x:Class="Assistant.UI.FiveMToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Title="FiveM Tools &amp; Utilities" TitleCharacterCasing="Normal" Height="480" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content Area -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- GroupBox 1: FiveM Settings (Side-by-Side Layout) -->
            <GroupBox Grid.Row="0" Header="FiveM Settings" Margin="0,0,0,8">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Update Channel -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Update Channel:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="UpdateChannelComboBox" Height="26" SelectionChanged="UpdateChannelComboBox_SelectionChanged">
                            <ComboBoxItem Content="Release"/>
                            <ComboBoxItem Content="Beta"/>
                            <ComboBoxItem Content="Latest (Unstable)"/>
                        </ComboBox>
                        <TextBlock Text="💡 Requires restarting FiveM to apply." FontSize="10.5" Foreground="#FF007ACC" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Right Column: GTA V Folder -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="GTA 5 Installation Folder:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GtaVPathTextBox" Grid.Column="0" Height="26" VerticalAlignment="Center" Margin="0,0,6,0" IsReadOnly="True"/>
                            <Button x:Name="BrowseGtaVPathBtn" Grid.Column="1" Content="Browse..." Width="70" Height="26" Click="BrowseGtaVPathBtn_Click"/>
                        </Grid>
                        <TextBlock Text="Folder containing GTA5.exe used by FiveM." FontSize="10.5" Foreground="Gray" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- GroupBox 2: Maintenance & Cache Clearing -->
            <GroupBox Grid.Row="1" Header="Maintenance &amp; Cache Clearing" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Clear Citizen Folder Card -->
                        <Border Grid.Column="0" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" CornerRadius="4" Padding="8" Background="{DynamicResource MahApps.Brushes.Background}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Clear Citizen System Folder" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Grid.Row="1" Text="Deletes FiveM.app\citizen folder to force FiveM to redownload fresh system files." FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <Button x:Name="ClearCitizenBtn" Grid.Row="2" Content="Clear Citizen" Height="26" Click="ClearCitizenBtn_Click"/>
                            </Grid>
                        </Border>

                        <!-- Clear Server Cache Card -->
                        <Border Grid.Column="2" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" CornerRadius="4" Padding="8" Background="{DynamicResource MahApps.Brushes.Background}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Clear Server Cache" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Grid.Row="1" Text="Deletes downloaded server assets so FiveM can redownload clean server files." FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <Button x:Name="ClearServerCacheBtn" Grid.Row="2" Content="Clear Cache" Height="26" Click="ClearServerCacheBtn_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- GroupBox 3: ReShade Setup -->
            <GroupBox Grid.Row="2" Header="ReShade Setup">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Top Section (Description Left, Button Right) -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Description text -->
                        <TextBlock Grid.Column="0" TextWrapping="Wrap" FontSize="11.5"
                                   Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                   VerticalAlignment="Center">
                            Automates relocating ReShade files to <Run FontWeight="Bold">FiveM.app\plugins</Run> and configuring the machine hardware key in <Run FontWeight="Bold">CitizenFX.ini</Run>.
                        </TextBlock>

                        <!-- Right Column: Action Button -->
                        <Button Grid.Column="1" x:Name="SetupReShadeBtn" Content="Setup &amp; Enable ReShade"
                                Width="180" Height="30" FontWeight="Bold" FontSize="12"
                                Click="SetupReShadeBtn_Click" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    </Grid>

                    <!-- Row 1: Inline Step indicators -->
                    <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Installation Steps &amp; Status:" FontWeight="Bold" FontSize="11.5" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Step 1 (Files): " FontSize="11" Foreground="Gray"/>
                            <TextBlock x:Name="Step1Text" Text="Not Detected" FontSize="11" FontWeight="SemiBold" Foreground="#FF4D4D"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Step 2 (Config): " FontSize="11" Foreground="Gray"/>
                            <TextBlock x:Name="Step2Text" Text="Not Configured" FontSize="11" FontWeight="SemiBold" Foreground="#FF4D4D"/>
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Bottom Action Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CloseBtn" Content="Close" Width="90" Height="28" Click="CloseBtn_Click"/>
        </StackPanel>
    </Grid>
</Controls:MetroWindow>
