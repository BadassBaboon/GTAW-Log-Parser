<Controls:MetroWindow x:Class="Assistant.UI.FiveMToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Title="FiveM Tools &amp; Utilities"
        TitleCharacterCasing="Normal"
        Height="550" Width="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        BorderThickness="0"
        GlowBrush="Black"
        ShowInTaskbar="False"
        IsMinButtonEnabled="False"
        IsMaxRestoreButtonEnabled="False"
        ShowIconOnTitleBar="False"
        Icon="pack://application:,,,/GTAWAssistant;component/Resources/AppIcon.ico">
    <Grid Margin="15,12,15,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content Area -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- GroupBox 1: FiveM Settings -->
            <GroupBox Grid.Row="0" Header="FiveM Settings" Margin="0,0,0,10">
                <StackPanel Margin="10,8">

                    <!-- Row 1: FiveM Directory & GTA V Folder (side-by-side) -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: FiveM Directory -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FiveM Directory:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FiveMPathTextBox" Grid.Column="0" Height="26" VerticalAlignment="Center" Margin="0,0,6,0" IsReadOnly="True"/>
                                <Button x:Name="BrowseFiveMPathBtn" Grid.Column="1" Content="Browse..." Width="70" Height="26" Click="BrowseFiveMPathBtn_Click"/>
                            </Grid>
                            <TextBlock Text="Folder containing FiveM.exe (auto-detected)." FontSize="10.5" Foreground="Gray" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Right: GTA V Folder -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="GTA 5 Installation Folder:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GtaVPathTextBox" Grid.Column="0" Height="26" VerticalAlignment="Center" Margin="0,0,6,0" IsReadOnly="True"/>
                                <Button x:Name="BrowseGtaVPathBtn" Grid.Column="1" Content="Browse..." Width="70" Height="26" Click="BrowseGtaVPathBtn_Click"/>
                            </Grid>
                            <TextBlock Text="Folder containing GTA5.exe used by FiveM." FontSize="10.5" Foreground="Gray" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Separator -->
                    <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="0,1,0,0" Margin="0,0,0,10"/>

                    <!-- Row 2: First-Person Driving FOV (left) & Update Channel (right) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="First-Person Driving FOV:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <ComboBox x:Name="FovPresetComboBox" Height="26" Width="150" Margin="0,0,8,0"
                                  SelectionChanged="FovPresetComboBox_SelectionChanged">
                            <ComboBoxItem Content="60° (Recommended)" Tag="60"/>
                            <ComboBoxItem Content="0° (FiveM Default)" Tag="0"/>
                            <ComboBoxItem Content="-1 (Game Default)" Tag="-1"/>
                            <ComboBoxItem Content="Custom..." Tag="custom"/>
                        </ComboBox>

                        <Controls:NumericUpDown x:Name="CustomFovNumericUpDown"
                                                Minimum="0" Maximum="130" Value="60" Interval="1"
                                                Height="26" Width="75"
                                                TextAlignment="Center" StringFormat="{}{0}°"
                                                Visibility="Collapsed"
                                                ValueChanged="CustomFovNumericUpDown_ValueChanged"/>

                        <TextBlock Text="Update Channel:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,10,0"/>
                        <ComboBox x:Name="UpdateChannelComboBox" Height="26" Width="140"
                                  SelectionChanged="UpdateChannelComboBox_SelectionChanged">
                            <ComboBoxItem Content="Release"/>
                            <ComboBoxItem Content="Beta"/>
                            <ComboBoxItem Content="Latest (Unstable)"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Hint -->
                    <TextBlock Text="💡 Note: Changes to FiveM settings require restarting FiveM to take effect." FontSize="10.5" Foreground="Gray" Margin="0,2,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- GroupBox 2: Maintenance & Cache Clearing -->
            <GroupBox Grid.Row="1" Header="Maintenance &amp; Cache Clearing" Margin="0,0,0,10">
                <StackPanel Margin="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Clear Citizen Folder Card -->
                        <Border Grid.Column="0" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" CornerRadius="4" Padding="8" Background="{DynamicResource MahApps.Brushes.Background}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Clear Citizen Folder" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Grid.Row="1" Text="Deletes citizen folder to force FiveM to redownload fresh system files." FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <Button x:Name="ClearCitizenBtn" Grid.Row="2" Content="Clear Citizen" Height="26" Click="ClearCitizenBtn_Click"/>
                            </Grid>
                        </Border>

                        <!-- Clear Server Cache Card -->
                        <Border Grid.Column="2" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" CornerRadius="4" Padding="8" Background="{DynamicResource MahApps.Brushes.Background}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Clear Server Cache" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Grid.Row="1" Text="Deletes server assets so FiveM can redownload clean server files." FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <Button x:Name="ClearServerCacheBtn" Grid.Row="2" Content="Clear Cache" Height="26" Click="ClearServerCacheBtn_Click"/>
                            </Grid>
                        </Border>

                        <!-- Restore Graphic Settings Card -->
                        <Border Grid.Column="4" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" CornerRadius="4" Padding="8" Background="{DynamicResource MahApps.Brushes.Background}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Restore Graphic Settings" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Grid.Row="1" Text="Deletes gta5_settings.xml to restore original graphic settings." FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <Button x:Name="ResetGraphicsBtn" Grid.Row="2" Content="Restore Graphics" Height="26" Click="ResetGraphicsBtn_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- GroupBox 3: ReShade Setup -->
            <GroupBox Grid.Row="2" Header="ReShade Setup" Margin="0,0,0,10">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Top Section (Description Left, Button Right) -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Description text -->
                        <TextBlock Grid.Column="0" TextWrapping="Wrap" FontSize="11.5"
                                   Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                   VerticalAlignment="Center">
                            Automates relocating ReShade files to <Run FontWeight="Bold">FiveM.app\plugins</Run> and configuring the machine hardware key in <Run FontWeight="Bold">CitizenFX.ini</Run>.
                        </TextBlock>

                        <!-- Right Column: Action Button -->
                        <Button Grid.Column="1" x:Name="SetupReShadeBtn" Content="Setup &amp; Enable ReShade"
                                Width="180" Height="30" FontWeight="Bold" FontSize="12"
                                Click="SetupReShadeBtn_Click" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    </Grid>

                    <!-- Row 1: Inline Step indicators -->
                    <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Installation Steps &amp; Status:" FontWeight="Bold" FontSize="11.5" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Step 1 (Files): " FontSize="11" Foreground="Gray"/>
                            <TextBlock x:Name="Step1Text" Text="Not Detected" FontSize="11" FontWeight="SemiBold" Foreground="#FF4D4D"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Step 2 (Config): " FontSize="11" Foreground="Gray"/>
                            <TextBlock x:Name="Step2Text" Text="Not Configured" FontSize="11" FontWeight="SemiBold" Foreground="#FF4D4D"/>
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Bottom Action Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="CloseBtn" Content="Close" Width="90" Height="28" Click="CloseBtn_Click"/>
        </StackPanel>
    </Grid>
</Controls:MetroWindow>
